<view class="page">
  <view class="gold-card hero">
    <text class="section-title">买它要上多久班</text>
    <!-- 价格输入 -->
    <view class="price-row">
      <text class="cur">{{currencySymbol}}</text>
      <input class="price-input" type="digit" placeholder="输入商品价格" placeholder-class="ph"
        value="{{price}}" bindinput="onPrice" />
    </view>
    <!-- 实时结果 -->
    <view class="calc-box" wx:if="{{calcText}}">
      <text class="calc-v">{{priceInput}}</text>
      <text class="calc-t">{{calcText}}</text>
    </view>
    <view wx:else class="calc-box empty">
      <text class="calc-v">{{psw}} 元/秒</text>
      <text class="calc-t">你的每秒时薪</text>
    </view>
    <!-- 商品名 -->
    <view class="name-row">
      <input class="name-input" placeholder="商品名（选填）" placeholder-class="ph"
        value="{{productName}}" bindinput="onName" />
    </view>
    <!-- 同步税后 -->
    <view class="sync-row">
      <text class="muted">按税后时薪计算</text>
      <switch checked="{{syncTaxAfter}}" bindchange="onToggleSync" color="#E8B84B" />
    </view>
  </view>

  <view class="tips">
    <text class="tip-line">💡 先输入价格，看看要搬多少砖</text>
  </view>
</view>