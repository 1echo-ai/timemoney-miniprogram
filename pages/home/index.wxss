/* pages/home/index.wxss */
.page {
  padding: 24rpx 30rpx 60rpx;
  box-sizing: border-box;
}

/* 顶部导航 */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}
.brand {
  font-size: 40rpx;
  font-weight: 700;
  color: #e8b84b;
  letter-spacing: 2rpx;
  display: block;
}
.sub {
  font-size: 22rpx;
  color: #8a88a0;
  margin-top: 6rpx;
  display: block;
}
.gear {
  width: 72rpx;
  height: 72rpx;
  background: #16161d;
  border: 1rpx solid rgba(232, 184, 75, 0.25);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.gear-icon {
  font-size: 40rpx;
  color: #e8b84b;
}

/* Hero */
.hero {
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  position: relative;
}
.hero-label {
  font-size: 26rpx;
  color: #8a88a0;
  display: block;
}
.hero-amount {
  display: flex;
  align-items: baseline;
  margin: 12rpx 0 8rpx;
}
.symbol {
  font-size: 44rpx;
  color: #e8b84b;
  margin-right: 8rpx;
}
.num {
  font-size: 96rpx;
  font-weight: 800;
  color: #f6f3ec;
  line-height: 1;
}

.eff-line {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 18rpx;
}
.eff-text {
  font-size: 24rpx;
  color: #cfcbbe;
}
.eff-warn {
  font-size: 22rpx;
  color: #ff6b6b;
  font-weight: 600;
}
.eff-delta.ok {
  font-size: 22rpx;
  color: #6bdf8f;
}
.eff-delta.warn {
  font-size: 22rpx;
  color: #ff6b6b;
}

.status-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.status-pill {
  display: flex;
  align-items: center;
  gap: 10rpx;
  background: rgba(107, 223, 143, 0.12);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #6bdf8f;
}
.status-pill.overtime_unpaid {
  background: rgba(255, 107, 107, 0.14);
  color: #ff6b6b;
}
.status-pill.overtime_paid {
  background: rgba(232, 184, 75, 0.14);
  color: #e8b84b;
}
.status-pill.idle {
  background: rgba(138, 136, 160, 0.14);
  color: #8a88a0;
}
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: currentColor;
}
.per-sec {
  font-size: 22rpx;
  color: #8a88a0;
}

.hero-bottom {
  display: flex;
  gap: 20rpx;
}
.hb-col {
  flex: 1;
  background: #101016;
  border-radius: 20rpx;
  padding: 20rpx;
}
.hb-v {
  font-size: 34rpx;
  font-weight: 700;
  color: #f0ede5;
  display: block;
}
.hb-l {
  font-size: 22rpx;
  color: #8a88a0;
  margin-top: 6rpx;
  display: block;
}

/* Insight */
.insight {
  padding: 28rpx 30rpx;
  margin-bottom: 24rpx;
}
.insight-cards {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}
.ins-item {
  flex: 1;
  background: #101016;
  border-radius: 20rpx;
  padding: 20rpx;
}
.ins-label {
  font-size: 22rpx;
  color: #8a88a0;
  display: block;
}
.ins-val {
  font-size: 32rpx;
  font-weight: 700;
  color: #e8b84b;
  margin-top: 8rpx;
  display: block;
}
.lost-row {
  margin-top: 20rpx;
  background: rgba(255, 107, 107, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
}
.lost-text {
  font-size: 22rpx;
  color: #ff6b6b;
}

.footer-tip {
  text-align: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  color: #5a5a66;
}

/* 配置弹窗 */
.mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.7);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.modal {
  width: 100%;
  background: #16161d;
  border-radius: 40rpx 40rpx 0 0;
  padding: 30rpx 36rpx 40rpx;
  box-sizing: border-box;
  max-height: 85vh;
}
.modal-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #f0ede5;
}
.modal-close {
  font-size: 36rpx;
  color: #8a88a0;
  padding: 8rpx;
}
.modal-body {
  max-height: 50vh;
}
.sec-gap {
  margin-top: 28rpx;
  display: block;
}
.field {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22rpx;
}
.field-label {
  font-size: 26rpx;
  color: #cfcbbe;
}
.input {
  width: 220rpx;
  text-align: right;
  background: #101016;
  color: #f0ede5;
  border-radius: 14rpx;
  padding: 12rpx 20rpx;
  font-size: 26rpx;
}
.picker {
  background: #101016;
  color: #f0ede5;
  border-radius: 14rpx;
  padding: 12rpx 24rpx;
  font-size: 26rpx;
}
.save-btn {
  margin-top: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
}