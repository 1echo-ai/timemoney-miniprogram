/* app.wxss 全局样式：深空黑 + 香槟金 */
page {
  background-color: #0b0b0f;
  color: #f2efe9;
  font-family: -apple-system, 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

/* 卡片 */
.gold-card {
  background: #16161d;
  border: 1rpx solid rgba(232, 184, 75, 0.18);
  border-radius: 28rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.4);
}

/* 金色主按钮 */
.btn-gold {
  background: linear-gradient(135deg, #e8b84b, #d99a2b);
  color: #1a1405;
  font-weight: 600;
  border: none;
  border-radius: 999rpx;
}

/* 次级描边按钮 */
.btn-outline {
  background: transparent;
  color: #e8b84b;
  border: 2rpx solid rgba(232, 184, 75, 0.5);
  border-radius: 999rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #e8b84b;
  letter-spacing: 2rpx;
}

.muted {
  color: #8a88a0;
}